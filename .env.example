# Copy to `.env` and fill in. Both values are read at build time by Expo, so
# restart the dev server after changing them.
#
# These are two SEPARATE keys in Google Cloud Console. Keep them separate so you
# can restrict and cap each one independently.

# Places API (New) — used by src/api/places.ts for autocomplete, place details,
# nearby search and photos. Restrict this key to "Places API (New)" ONLY.
EXPO_PUBLIC_GOOGLE_PLACES_KEY=

# Maps SDK for Android / Maps SDK for iOS — used by react-native-maps to render
# the map tiles. Restrict this key to those two SDKs ONLY.
EXPO_PUBLIC_GOOGLE_MAPS_KEY=
